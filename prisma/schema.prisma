generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id String @id @default(cuid())

  clerkId String @unique
  email   String @unique

  username String?
  imageUrl String?

  githubUsername    String?
  githubAccessToken String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  repositories Repository[]
}

model Repository {
  id              String   @id @default(cuid())
  githubId        Int      @unique
  name            String
  fullName        String
  description     String?
  htmlUrl         String
  cloneUrl        String
  defaultBranch   String
  isPrivate       Boolean
  language        String?
  stargazersCount Int
  forksCount      Int
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  ownerId         String
  owner           User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  analysis RepositoryAnalysis?
  files RepositoryFile[]
  languageStats LanguageStat[]
  frameworks Framework[]
  dependencies Dependency[]
  metrics RepositoryMetric?
  codeMetrics CodeMetric[]

  @@index([ownerId])
}

model RepositoryAnalysis {
  id           String   @id @default(cuid())
  summary      String
  techStack    String[]
  difficulty   String?
  architecture String?
  suggestions  String[]

  repositoryId String     @unique
  repository   Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model RepositoryFile {
  id           String   @id @default(cuid())

  path         String
  name         String
  extension    String
  language     String?
  size         Int
  lineCount    Int

  repositoryId String
  repository   Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([repositoryId])
  @@index([language])
  @@index([extension])
}

model LanguageStat {
  id String @id @default(cuid())

  language String

  fileCount Int
  lineCount Int
  percentage Float

  repositoryId String
  repository Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([repositoryId])
}

model Framework {
  id String @id @default(cuid())

  name String
  version String?

  category String

  repositoryId String
  repository Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([repositoryId])
}
enum DependencyType {
  PRODUCTION
  DEVELOPMENT
}
model Dependency {
  id String @id @default(cuid())

  name    String
  version String
  type DependencyType

  repositoryId String
  repository Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([repositoryId])
  @@index([type])
  @@unique([repositoryId, name])
}

model RepositoryMetric {
  id String @id @default(cuid())

  totalFiles Int
  totalLines Int

  averageFileSize Float

  repositoryId String @unique
  repository Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CodeMetric {
  id String @id @default(cuid())

  path String

  functions Int
  classes Int
  interfaces Int

  imports Int
  exports Int

  repositoryId String
  repository Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([repositoryId])
}